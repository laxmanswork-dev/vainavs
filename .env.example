# Copy this file to .env.local and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client code.

# Base URL for API requests (see src/services/apiClient.js). Leave unset to
# default to "/api" (same-origin, useful behind a reverse proxy).
VITE_API_BASE_URL=

# Public site URL — used to build canonical/OG URLs in src/constants/site.js.
VITE_SITE_URL=https://www.vainivascafe.com
